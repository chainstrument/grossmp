<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Grossmp{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
        {% if app.user %}
            <header class="border-b border-gray-200 bg-white">
                <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
                    <a href="{{ path('app_catalog_index') }}" class="text-lg font-semibold text-gray-900">Grossmp</a>
                    <div class="flex items-center gap-4 text-sm">
                        <a href="{{ path('app_catalog_index') }}" class="text-gray-600 hover:text-gray-900">Catalogue</a>
                        {% if app.user.company %}
                            <a href="{{ path('app_cart_index') }}" class="text-gray-600 hover:text-gray-900">Panier</a>
                        {% endif %}
                        {% if app.user.company or is_granted('ROLE_VALIDATOR') %}
                            <a href="{{ path('app_order_index') }}" class="text-gray-600 hover:text-gray-900">Commandes</a>
                        {% endif %}
                        <a href="{{ path('app_account') }}" class="text-gray-600 hover:text-gray-900">Mon compte</a>
                        <a href="{{ path('app_logout') }}" class="text-gray-600 hover:text-gray-900">Déconnexion</a>
                    </div>
                </nav>
            </header>
        {% endif %}

        <main class="mx-auto max-w-5xl px-4 py-8">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
