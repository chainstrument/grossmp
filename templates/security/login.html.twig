{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="mx-auto max-w-sm">
        <h1 class="mb-6 text-2xl font-semibold text-gray-900">Connexion</h1>

        {% if error %}
            <div data-testid="login-error" class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="space-y-4">
            <div>
                <label for="username" class="mb-1 block text-sm font-medium text-gray-700">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus
                       class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500">
            </div>

            <div>
                <label for="password" class="mb-1 block text-sm font-medium text-gray-700">Mot de passe</label>
                <input type="password" name="_password" id="password" autocomplete="current-password" required
                       class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit"
                    class="w-full rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
                Se connecter
            </button>
        </form>
    </div>
{% endblock %}
